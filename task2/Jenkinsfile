pipeline {
    agent any

    environment {
        DOCKERHUB_USER = 'bella38'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Adityapratapsingh28/-ci-cd-demo-.git'
            }
        }

        stage('Build Blue and Green Images') {
            steps {
                // build both versions once so the cluster has them ready
                sh 'docker build -t $DOCKERHUB_USER/bg-demo:blue ./task2/blue'
                sh 'docker build -t $DOCKERHUB_USER/bg-demo:green ./task2/green'
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                    sh 'echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin'
                    sh 'docker push $DOCKERHUB_USER/bg-demo:blue'
                    sh 'docker push $DOCKERHUB_USER/bg-demo:green'
                }
            }
        }

        stage('Deploy Both Environments') {
            steps {
                // blue and green run side by side, but only blue gets traffic
                sh 'kubectl --kubeconfig /var/lib/jenkins/kube/config apply -f task2/k8s/blue-deployment.yaml'
                sh 'kubectl --kubeconfig /var/lib/jenkins/kube/config apply -f task2/k8s/green-deployment.yaml'
                sh 'kubectl --kubeconfig /var/lib/jenkins/kube/config apply -f task2/k8s/service.yaml'
                sh 'kubectl --kubeconfig /var/lib/jenkins/kube/config rollout status deployment/bg-app-blue --timeout=120s'
                sh 'kubectl --kubeconfig /var/lib/jenkins/kube/config rollout status deployment/bg-app-green --timeout=120s'
            }
        }

        stage('Smoke Test Green') {
            steps {
                // check green actually serves the new page before switching any users to it
                script {
                    def greenPod = sh(
                        script: 'kubectl --kubeconfig /var/lib/jenkins/kube/config get pods -l version=green -o jsonpath="{.items[0].metadata.name}"',
                        returnStdout: true
                    ).trim()
                    sh 'kubectl --kubeconfig /var/lib/jenkins/kube/config exec $greenPod -- wget -qO- http://localhost | grep -i "GREEN" || exit 1'
                    echo 'Green environment passed the smoke test'
                }
            }
        }

        stage('Approval Gate') {
            steps {
                // pipeline pauses here - click "Proceed" in the Jenkins UI to switch traffic
                input message: 'Green is healthy. Switch production traffic from BLUE to GREEN?', ok: 'Switch to Green'
            }
        }

        stage('Switch Traffic to Green') {
            steps {
                // THE blue-green switch: change the service selector from blue to green
                sh 'kubectl --kubeconfig /var/lib/jenkins/kube/config patch svc bg-app-svc -p \'{"spec":{"selector":{"version":"green"}}}\''
                echo 'Traffic now goes to GREEN. Blue is still running for instant rollback.'
            }
        }

        stage('Verify Switch') {
            steps {
                sh 'sleep 3'
                sh 'kubectl --kubeconfig /var/lib/jenkins/kube/config get svc bg-app-svc -o jsonpath="{.spec.selector.version}"'
            }
        }
    }

    post {
        success {
            echo '=== BLUE-GREEN DEPLOYMENT COMPLETE ==='
        }
        failure {
            echo '=== PIPELINE FAILED - BLUE STILL SERVES TRAFFIC, PRODUCTION UNAFFECTED ==='
        }
    }
}
