pipeline {
    agent any

    environment {
        DOCKERHUB_USER = 'bella38'
        KUBE = '--kubeconfig /var/lib/jenkins/kube/config'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Adityapratapsingh28/-ci-cd-demo-.git'
            }
        }

        stage('Security Gate 1: Secret Scan') {
            steps {
                // gitleaks scans all source code for hardcoded passwords / keys / tokens
                // this FAILS the build if any secret is found -> nothing gets deployed
                sh 'gitleaks detect --source . --no-git --redact'
            }
        }

        stage('Build Image') {
            steps {
                sh 'docker build -t $DOCKERHUB_USER/hospital-app:$BUILD_NUMBER -t $DOCKERHUB_USER/hospital-app:latest ./task3/app'
            }
        }

        stage('Security Gate 2: Image CVE Scan') {
            steps {
                // trivy scans the container image for critical vulnerabilities
                sh 'trivy image --exit-code 1 --ignore-unfixed --severity CRITICAL $DOCKERHUB_USER/hospital-app:$BUILD_NUMBER'
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                    sh 'echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin'
                    sh 'docker push $DOCKERHUB_USER/hospital-app:$BUILD_NUMBER'
                    sh 'docker push $DOCKERHUB_USER/hospital-app:latest'
                }
            }
        }

        stage('Security Gate 3: K8s Config Audit') {
            steps {
                // trivy checks the kubernetes manifests for insecure configuration
                sh 'trivy config --exit-code 1 --severity CRITICAL ./task3/k8s'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh 'kubectl $KUBE apply -f task3/k8s/deployment.yaml'
                sh 'kubectl $KUBE set image deployment/hospital-app hospital-app=$DOCKERHUB_USER/hospital-app:$BUILD_NUMBER'
                sh 'kubectl $KUBE rollout status deployment/hospital-app --timeout=120s'
            }
        }
    }

    post {
        success {
            echo '=== ALL SECURITY GATES PASSED - APP DEPLOYED ==='
        }
        failure {
            echo '=== BLOCKED BY SECURITY GATE - NOTHING REACHED PRODUCTION ==='
        }
    }
}
